
@model Dictionary<string, string>
@{ ViewBag.Title = "Our Story"; }

<style>
 
    .hero-wrapper { position: relative; width: 100%; height: 85vh; overflow: hidden; }
    .hero-image {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: url('@Url.Content("~/Content/Images/wide.jpg")') no-repeat center center;
        background-size: cover;
        -webkit-mask-image: linear-gradient(to bottom, black 0%, black 70%, rgba(0,0,0,0.5) 85%, transparent 100%);
        mask-image: linear-gradient(to bottom, black 0%, black 70%, rgba(0,0,0,0.5) 85%, transparent 100%);
    }
    .hero-content {
        position: relative;
        z-index: 10;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
        /* The Fix: Pulls the content up by 3% of the viewport height */
        margin-top: -3vh;
    }

    .hero-pill {
        background: rgba(255, 255, 255, 0.15);
        padding: 16px 48px;
        border-radius: 100px;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        /* Adding a smooth transition in case you want to hover it later */
        transition: all 0.3s ease;
    }

        .hero-pill h1 {
            color: #c9184a;
            font-weight: 800;
            margin: 0;
            letter-spacing: 3.2px;
            text-transform: uppercase;
            font-size: 3.2rem;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        }
        .counter-box { background: white; padding: 40px; border-radius: 50px; margin-top: -100px; position: relative; z-index: 20; box-shadow: 0 15px 35px rgba(0,0,0,0.1); }

    /* 1. GALLERY STYLES */
    .gallery-item { cursor: pointer; transition: transform 0.3s ease; }
    .gallery-item:hover { transform: scale(1.02); }
    .gallery-item img { width: 100%; height: 400px; object-fit: cover; border-radius: 15px; }

    /* 2. MODAL (POP-UP) STYLES */
    .modal-overlay {
        display: none;
        position: fixed;
        z-index: 9999;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(5px);
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }
    .modal-img { max-width: 90%; max-height: 80vh; border-radius: 10px; box-shadow: 0 0 20px rgba(255,255,255,0.2); }
    #modal-caption { color: white; margin-top: 20px; font-family: 'Dancing Script', cursive; font-size: 1.8rem; }
    .close-btn { position: absolute; top: 20px; right: 30px; color: white; font-size: 40px; cursor: pointer; }
</style>

<section class="hero-wrapper">
    <div class="hero-image"></div>
    <div class="hero-content" data-aos="zoom-in">
        <div class="hero-pill">
            <h1 class="display-1">Our Story</h1>
        </div>
    </div>
</section>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 counter-box text-center" data-aos="fade-up">
            <h2 class="text-danger mb-4">10•10•2020|Together For...</h2>
            <div id="love-counter" class="display-6 fw-bold"></div>
        </div>
    </div>

    <div class="row mt-5">
        @foreach (var item in Model)
        {
            var imgPath = "/Content/Images/" + item.Key;
            var message = item.Value;

            <div class="col-md-4 mb-4" data-aos="fade-up">
                <div class="gallery-item" onclick="openPopup('@Url.Content(imgPath)', '@message')">
                    <img src="@Url.Content(imgPath)" />
                    <p class="text-center mt-2 text-muted small">Click to read note</p>
                </div>
            </div>
        }
    </div>
</div>

<div id="imageModal" class="modal-overlay" onclick="closePopup()">
    <span class="close-btn">&times;</span>
    <img class="modal-img" id="fullImage">
    <div id="modal-caption"></div>
</div>

<script>
    // --- Counter Logic ---
    const startDate = new Date('@(ViewBag.AnniversaryDate.ToString("yyyy-MM-dd"))');
    function updateCounter() {
        const diff = new Date() - startDate;
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff / 3600000) % 24);
        const m = Math.floor((diff / 60000) % 60);
        const s = Math.floor((diff / 1000) % 60);
        document.getElementById('love-counter').innerHTML = `${d}d : ${h}h : ${m}m : ${s}s`;
    }
    setInterval(updateCounter, 1000);
    updateCounter();

    // --- 5. POP-UP LOGIC ---
    function openPopup(src, caption) {
        document.getElementById('imageModal').style.display = 'flex';
        document.getElementById('fullImage').src = src;
        document.getElementById('modal-caption').innerText = caption;
    }

    function closePopup() {
        document.getElementById('imageModal').style.display = 'none';
    }
</script>